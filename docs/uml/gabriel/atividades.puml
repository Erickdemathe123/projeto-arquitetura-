@startuml
start
:Professor autentica-se;
repeat
  :Cadastra questões objetivas;
  if (2–5 alternativas e uma correta?) then (não)
    :Corrigir dados da questão;
  endif
repeat while (Dados inválidos?) is (sim) not (não)
:Cria a prova (draft);
:Seleciona questões e pontuações;
:Escolhe a turma;
:Vincula a prova à turma;
:Prova passa a ready na primeira aplicação;
note right
  Planejado para N3:
  embaralhar versões, imprimir,
  escanear respostas e corrigir.
end note
stop
@enduml
