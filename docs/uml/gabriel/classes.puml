@startuml
skinparam classAttributeIconSize 0
class User {
  +id: bigint
  +name: string
  +email: string
  -passwordHash: string
  +role: professor|aluno
}
class Class {
  +id: bigint
  +name: string
  +inviteCode: string
  +teacherId: bigint
}
class Enrollment {
  +id: bigint
  +classId: bigint
  +studentId: bigint
  +enrolledAt: datetime
}
class Question {
  +id: bigint
  +statement: text
  +teacherId: bigint
}
class Alternative {
  +id: bigint
  +text: string
  +isCorrect: boolean
  +position: number
}
class Exam {
  +id: bigint
  +title: string
  +status: draft|ready|closed
  +teacherId: bigint
}
class ExamQuestion {
  +id: bigint
  +points: decimal
  +position: number
}
class Application {
  +id: bigint
  +examId: bigint
  +classId: bigint
}
User "1 professor" -- "0..*" Class
User "1 professor" -- "0..*" Question
User "1 professor" -- "0..*" Exam
User "1 aluno" -- "0..*" Enrollment
Class "1" -- "0..*" Enrollment
Question "1" -- "2..5" Alternative
Exam "1" -- "1..*" ExamQuestion
Question "1" -- "0..*" ExamQuestion
Exam "1" -- "0..*" Application
Class "1" -- "0..*" Application
note bottom of Alternative
  Exatamente uma alternativa correta.
  Posições iniciam em zero.
end note
note bottom of Exam
  1..* itens para a prova pronta/aplicável.
  Um draft pode estar em construção.
end note
@enduml
