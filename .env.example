# Copie este arquivo para ".env" e preencha com os dados do seu MySQL local.
# O arquivo .env NÃO deve ser enviado ao GitHub (já está no .gitignore).

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=sgp
DB_SSL=false
# Para MySQL gerenciado, use DB_SSL=true e informe o caminho do CA certificate.
DB_SSL_CA_PATH=

# Configurações de Autenticação (JWT)
# Gere um valor novo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Em produção (Render), JWT_SECRET é obrigatório e deve ter ao menos 32 caracteres.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# URL opcional impressa na folha para consulta pública do aluno.
PUBLIC_STUDENT_PORTAL_URL=https://projeto-arquitetura-iota.vercel.app/aluno
