# Copie este arquivo para ".env" e preencha com os dados do seu MySQL local.
# O arquivo .env NÃO deve ser enviado ao GitHub (já está no .gitignore).

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=sgp

# Configurações de Autenticação (JWT)
JWT_SECRET=seu_segredo_jwt_super_seguro_aqui
JWT_EXPIRES_IN=8h
