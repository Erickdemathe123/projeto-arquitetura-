# Copie este arquivo para ".env" e preencha com os dados do seu MySQL local.
# O arquivo .env NÃO deve ser enviado ao GitHub (já está no .gitignore).

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=sgp

# T12: segredo aleatório (mínimo 32 bytes) compartilhado com o emissor JWT da T11.
# Gere localmente; não versione o valor real.
JWT_SECRET=
